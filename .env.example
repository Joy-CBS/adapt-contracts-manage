# --- Upstage Studio (서버 전용, 브라우저로 노출 금지) ---
UPSTAGE_API_KEY=
UPSTAGE_API_BASE=https://api.upstage.ai
# PoC 전용 Studio Project ID (없으면 비워 둠: 키 소유자의 개인 공간)
UPSTAGE_PROJECT_ID=

# --- DB (Neon Postgres: Vercel Marketplace에서 연결하면 자동 주입) ---
DATABASE_URL=

# --- 파일 저장소 (Vercel Blob: 생성된 .docx, Slack 첨부 원본) ---
BLOB_READ_WRITE_TOKEN=

# --- 외부 공유 데모 보호 (설정 시 Basic Auth, 아이디는 아무 값) ---
DEMO_PASSWORD=

# --- Slack (F6 단계에서 사용) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_REVIEW_CHANNEL_ID=
SLACK_LEGAL_CHANNEL_ID=

# --- 로컬 일괄 적재(F1) ---
# 계약서 원본 폴더(로컬 경로). 감사 추적 인증서는 자동 제외.
CONTRACTS_DIR=
